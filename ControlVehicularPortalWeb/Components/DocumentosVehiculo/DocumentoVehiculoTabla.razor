@using ControlVehicular.DTO.DocumentosVehiculo

@if (Cargando)
{
    <p class="table-message" role="status">Cargando documentos…</p>
}
else if (Documentos.Count == 0)
{
    <p class="table-message">@MensajeVacio</p>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Documentos con desplazamiento horizontal">
        <table class="readings-table">
            <colgroup>
                <col class="column-id" />
                <col class="column-vehicle" />
                <col class="column-type" />
                <col class="column-date" />
                <col class="column-expiry" />
                <col class="column-validity" />
                <col class="column-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Documento</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Emisión</th>
                    <th scope="col">Vencimiento</th>
                    <th scope="col">Vigencia</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var documento in Documentos)
                {
                    <tr @key="documento.Id">
                        <th scope="row">#@documento.Id</th>
                        <td>
                            <span class="cell-text" title="@NombreVehiculo(documento.VehiculoId)">@NombreVehiculo(documento.VehiculoId)</span>
                        </td>
                        <td><span class="status status-type">@NombreTipo(documento.Tipo)</span></td>
                        <td>@(documento.FechaEmision?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@(documento.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            <span class="status @(documento.Activo ? "status-active" : "status-inactive")">
                                @(documento.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button type="button" class="btn-details"
                                        disabled="@Ocupado" @onclick="() => VerDetalle.InvokeAsync(documento.Id)">
                                    Ver
                                </button>
                                <button type="button" class="btn-edit"
                                        disabled="@Ocupado" @onclick="() => Editar.InvokeAsync(documento.Id)">
                                    Editar
                                </button>
                                <button type="button"
                                        class="@(documento.Activo ? "btn-deactivate" : "btn-activate")"
                                        disabled="@Ocupado" @onclick="() => CambiarVigencia.InvokeAsync(documento)">
                                    @(documento.Activo ? "Desactivar" : "Activar")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<DocumentoVehiculoResponse> Documentos { get; set; } = [];

    [Parameter]
    public Func<long, string> NombreVehiculo { get; set; } = id => $"Vehículo #{id}";

    [Parameter]
    public string MensajeVacio { get; set; } = string.Empty;

    [Parameter]
    public bool Cargando { get; set; }

    [Parameter]
    public bool Ocupado { get; set; }

    [Parameter]
    public Func<string, string> NombreTipo { get; set; } = tipo => tipo;

    [Parameter]
    public EventCallback<long> VerDetalle { get; set; }

    [Parameter]
    public EventCallback<long> Editar { get; set; }

    [Parameter]
    public EventCallback<DocumentoVehiculoResponse> CambiarVigencia { get; set; }
}
