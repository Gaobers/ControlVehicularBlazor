@using ControlVehicular.DTO.DocumentosVehiculo

<section class="details-card" aria-labelledby="titulo-detalle">
    <div class="details-header">
        <h2 id="titulo-detalle">Detalle del documento #@Documento.Id</h2>
        <button type="button" class="btn-close-custom" @onclick="Cerrar">Cerrar</button>
    </div>

    <dl class="details-grid">
        <div>
            <dt>Vehículo</dt>
            <dd>@Vehiculo</dd>
        </div>
        <div>
            <dt>Tipo</dt>
            <dd>@Tipo</dd>
        </div>
        <div>
            <dt>Número de documento</dt>
            <dd>@(Documento.NumeroDocumento ?? "Sin número")</dd>
        </div>
        <div>
            <dt>Entidad emisora</dt>
            <dd>@(Documento.EntidadEmisora ?? "Sin entidad emisora")</dd>
        </div>
        <div>
            <dt>Fecha de emisión</dt>
            <dd>@(Documento.FechaEmision?.ToString("dd/MM/yyyy") ?? "Sin fecha")</dd>
        </div>
        <div>
            <dt>Fecha de vencimiento</dt>
            <dd>@(Documento.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</dd>
        </div>
        <div>
            <dt>Vigencia del registro</dt>
            <dd>@(Documento.Activo ? "Activo" : "Inactivo")</dd>
        </div>
        <div>
            <dt>Descripción</dt>
            <dd>@(Documento.Descripcion ?? "Sin descripción")</dd>
        </div>
        <div>
            <dt>Fecha de registro</dt>
            <dd>@Documento.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
        </div>
        <div>
            <dt>Última actualización</dt>
            <dd>@Documento.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</dd>
        </div>
    </dl>
</section>

@code {
    [Parameter, EditorRequired]
    public DocumentoVehiculoResponse Documento { get; set; } = default!;

    [Parameter]
    public string Vehiculo { get; set; } = string.Empty;

    [Parameter]
    public string Tipo { get; set; } = string.Empty;

    [Parameter]
    public EventCallback Cerrar { get; set; }
}
