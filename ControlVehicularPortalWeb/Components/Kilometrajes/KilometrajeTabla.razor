@using ControlVehicular.DTO.Kilometrajes

@if (Cargando)
{
    <p class="table-message" role="status">Cargando historial de lecturas…</p>
}
else if (Lecturas.Count == 0)
{
    <p class="table-message">@MensajeVacio</p>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Historial de kilometrajes con desplazamiento horizontal">
        <table class="readings-table">
            <colgroup>
                <col class="column-id" />
                <col class="column-vehicle" />
                <col class="column-mileage" />
                <col class="column-date" />
                <col class="column-status" />
                <col class="column-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Lectura</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">Kilometraje</th>
                    <th scope="col">Fecha y hora</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lectura in Lecturas)
                {
                    <tr @key="lectura.Id">
                        <th scope="row">#@lectura.Id</th>
                        <td>
                            <span class="cell-text" title="@NombreVehiculo(lectura.VehiculoId)">@NombreVehiculo(lectura.VehiculoId)</span>
                        </td>
                        <td class="text-nowrap">@lectura.Kilometraje.ToString("N1") km</td>
                        <td>@(lectura.FechaHora?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</td>
                        <td>
                            <span class="status @(lectura.Activo ? "status-active" : "status-inactive")">
                                @(lectura.Activo ? "Activa" : "Inactiva")
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button type="button" class="btn-details"
                                        disabled="@Ocupado" @onclick="() => VerDetalle.InvokeAsync(lectura.Id)">
                                    Ver
                                </button>
                                <button type="button" class="btn-edit"
                                        disabled="@Ocupado" @onclick="() => Editar.InvokeAsync(lectura.Id)">
                                    Editar
                                </button>
                                @if (lectura.Activo)
                                {
                                    <button type="button" class="btn-deactivate"
                                            disabled="@Ocupado" @onclick="() => Desactivar.InvokeAsync(lectura)">
                                        Desactivar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<KilometrajeSalidaDTO> Lecturas { get; set; } = [];

    [Parameter]
    public Func<long, string> NombreVehiculo { get; set; } = id => $"Vehículo #{id}";

    [Parameter]
    public string MensajeVacio { get; set; } = string.Empty;

    [Parameter]
    public bool Cargando { get; set; }

    [Parameter]
    public bool Ocupado { get; set; }

    [Parameter]
    public EventCallback<long> VerDetalle { get; set; }

    [Parameter]
    public EventCallback<long> Editar { get; set; }

    [Parameter]
    public EventCallback<KilometrajeSalidaDTO> Desactivar { get; set; }
}
