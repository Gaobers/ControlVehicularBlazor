@using ControlVehicular.DTO.Mantenimientos

@if (Cargando)
{
    <p class="table-message" role="status">Cargando mantenimientos…</p>
}
else if (Mantenimientos.Count == 0)
{
    <p class="table-message">@MensajeVacio</p>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Mantenimientos con desplazamiento horizontal">
        <table class="readings-table">
            <thead>
                <tr>
                    <th scope="col">Servicio</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">Fecha objetivo</th>
                    <th scope="col">Kilometraje objetivo (km)</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Vigencia</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mantenimiento in Mantenimientos)
                {
                    <tr @key="mantenimiento.Id">
                        <th scope="row">@mantenimiento.Servicio</th>
                        <td>@NombreVehiculo(mantenimiento.VehiculoId)</td>
                        <td class="text-nowrap">@(mantenimiento.FechaObjetivo?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@(mantenimiento.KilometrajeObjetivo?.ToString("N1") ?? "—")</td>
                        <td>
                            <span class="status status-estado @mantenimiento.Estado">@mantenimiento.Estado</span></td>
                        <td>
                            <span class="status @(mantenimiento.Activo ? "status-active" : "status-inactive")">
                                @(mantenimiento.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button type="button" class="btn-details"
                                        disabled="@Ocupado" @onclick="() => VerDetalle.InvokeAsync(mantenimiento.Id)">
                                    Ver
                                </button>
                                <button type="button" class="btn-edit"
                                        disabled="@Ocupado" @onclick="() => Editar.InvokeAsync(mantenimiento.Id)">
                                    Editar
                                </button>
                                @if (mantenimiento.Activo)
                                {
                                    <button type="button" class="btn-deactivate"
                                            disabled="@Ocupado" @onclick="() => Desactivar.InvokeAsync(mantenimiento)">
                                        Desactivar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<MantenimientoSalidaDTO> Mantenimientos { get; set; } = [];

    [Parameter]
    public Func<long, string> NombreVehiculo { get; set; } = id => $"Vehículo #{id}";

    [Parameter]
    public string MensajeVacio { get; set; } = string.Empty;

    [Parameter]
    public bool Cargando { get; set; }

    [Parameter]
    public bool Ocupado { get; set; }

    [Parameter]
    public EventCallback<long> VerDetalle { get; set; }

    [Parameter]
    public EventCallback<long> Editar { get; set; }

    [Parameter]
    public EventCallback<MantenimientoSalidaDTO> Desactivar { get; set; }
}
