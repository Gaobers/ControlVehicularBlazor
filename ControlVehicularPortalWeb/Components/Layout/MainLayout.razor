@inherits LayoutComponentBase
@implements IDisposable

@using ControlVehicular.Services
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager Navigation

<div class="portal">
    <aside class="portal-sidebar" aria-label="Menú del portal">
        <NavMenu />
    </aside>

    <div class="portal-workspace">
        <header class="portal-header">
            <div class="section-heading">
                <span class="portal-label">PORTAL ADMINISTRATIVO</span>
                <p class="section-title">@tituloSeccion</p>
            </div>

            <div class="header-actions">
                <span class="portal-identity">Control Vehicular</span>

                <AuthorizeView>
                    <Authorized>
                        <form method="post" action="sesion/logout" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="session-action">
                                Cerrar sesión
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="session-action" href="login" data-enhance-nav="false">
                            Iniciar sesión
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main id="contenido-principal" class="portal-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" role="alert">
    Se produjo un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss" role="button" tabindex="0" aria-label="Cerrar aviso">×</a>
</div>

@code {
    private string tituloSeccion = "Inicio";

    protected override void OnInitialized()
    {
        ActualizarTitulo();
        Navigation.LocationChanged += AlCambiarUbicacion;
    }

    private void ActualizarTitulo()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);
        var rutaSinParametros = ruta.Split('?', '#')[0].Trim('/');

        tituloSeccion = rutaSinParametros.ToLowerInvariant() switch
        {
            "vehiculos" => "Gestión de Vehículos",
            "kilometrajes" => "Kilometrajes",
            "mantenimientos" => "Mantenimientos",
            "recordatorios" => "Recordatorios",
            "gastos" => "Gastos",
            "documentos-vehiculos" => "Documentos Vehiculares",
            "estadisticas-gastos" => "Estadísticas de Gastos",
            _ => "Inicio"
        };
    }

    private void AlCambiarUbicacion(object? remitente, LocationChangedEventArgs argumentos)
    {
        _ = InvokeAsync(() =>
        {
            ActualizarTitulo();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarUbicacion;
    }
}
