<div class="navigation-shell">
    <div class="brand-row">
        <a class="portal-brand" href="">
            <span class="brand-mark" aria-hidden="true">CV</span>
            <span class="brand-name">
                <strong>Control Vehicular</strong>
                <span>Portal Web</span>
            </span>
        </a>

        <button type="button"
                class="menu-toggle"
                aria-label="Mostrar u ocultar navegación"
                aria-controls="navegacion-principal"
                aria-expanded="@(menuAbierto ? "true" : "false")"
                @onclick="AlternarMenu">
            <span aria-hidden="true">☰</span>
            Menú
        </button>
    </div>

    <div id="navegacion-principal"
         class="navigation-content @(menuAbierto ? "is-open" : "")">
        <span class="navigation-label">NAVEGACIÓN PRINCIPAL</span>

        <nav aria-label="Navegación principal">
            <div class="navigation-item">
                <NavLink class="navigation-link"
                         href=""
                         Match="NavLinkMatch.All"
                         @onclick="CerrarMenu">
                    <span class="navigation-symbol" aria-hidden="true">⌂</span>
                    Inicio
                </NavLink>
            </div>

            <div class="navigation-item">
                <NavLink class="navigation-link"
                         href="vehiculos"
                         @onclick="CerrarMenu">
                    <span class="navigation-symbol" aria-hidden="true">▤</span>
                    Gestión de Vehículos
                </NavLink>
            </div>
        </nav>

        <div class="navigation-footer">
            <span class="footer-mark" aria-hidden="true"></span>
            Portal de Control Vehicular
        </div>
    </div>
</div>

@code {
    private bool menuAbierto;

    private void AlternarMenu()
    {
        menuAbierto = !menuAbierto;
    }

    private void CerrarMenu()
    {
        menuAbierto = false;
    }
}
