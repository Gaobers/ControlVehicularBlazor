
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <!-- BOOTSTRAP -->
    <link rel="stylesheet"
          href="bootstrap/bootstrap.min.css" />

    <!-- ESTILOS GENERALES -->
    <link rel="stylesheet"
          href="css/app.css" />

    <!-- ESTILOS AISLADOS DE BLAZOR -->
    <link rel="stylesheet"
          href="ControlVehicularPortalWeb.styles.css" />

    <link rel="icon"
          type="image/png"
          href="favicon.png" />

    <HeadOutlet @rendermode="ModoRenderizado" />
</head>

<body>

    <Routes @rendermode="ModoRenderizado" />

    <script src="_framework/blazor.web.js"></script>

</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext ContextoHttp { get; set; } = default!;

    private Microsoft.AspNetCore.Components.IComponentRenderMode? ModoRenderizado =>
        ContextoHttp.Request.Path.StartsWithSegments("/login")
            ? null
            : InteractiveServer;
}
