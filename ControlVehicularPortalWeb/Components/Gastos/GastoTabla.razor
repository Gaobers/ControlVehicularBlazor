@using ControlVehicular.DTO.Gastos

@if (Cargando)
{
    <p class="table-message" role="status">Cargando gastos…</p>
}
else if (Gastos.Count == 0)
{
    <p class="table-message">@MensajeVacio</p>
}
else
{
    <div class="table-responsive" tabindex="0" role="region" aria-label="Gastos con desplazamiento horizontal">
        <table class="readings-table">
            <thead>
                <tr>
                    <th scope="col">Gasto</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">ID de categoría</th>
                    <th scope="col">Monto</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Vigencia</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gasto in Gastos)
                {
                    <tr @key="gasto.Id">
                        <th scope="row">#@gasto.Id</th>
                        <td>@NombreVehiculo(gasto.VehiculoId)</td>
                        <td>#@gasto.CategoriaId</td>
                        <td class="money-value">@gasto.Monto.ToString("N2") @(gasto.Moneda ?? "Sin moneda")</td>
                        <td>@gasto.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status @(gasto.Activo ? "status-active" : "status-inactive")">
                                @(gasto.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <button type="button" class="btn-details"
                                        disabled="@Ocupado" @onclick="() => VerDetalle.InvokeAsync(gasto.Id)">
                                    Ver
                                </button>
                                <button type="button" class="btn-edit"
                                        disabled="@Ocupado" @onclick="() => Editar.InvokeAsync(gasto.Id)">
                                    Editar
                                </button>
                                @if (gasto.Activo)
                                {
                                    <button type="button" class="btn-deactivate"
                                            disabled="@Ocupado" @onclick="() => Desactivar.InvokeAsync(gasto)">
                                        Desactivar
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<GastoSalidaDTO> Gastos { get; set; } = [];

    [Parameter]
    public Func<long, string> NombreVehiculo { get; set; } = id => $"Vehículo #{id}";

    [Parameter]
    public string MensajeVacio { get; set; } = string.Empty;

    [Parameter]
    public bool Cargando { get; set; }

    [Parameter]
    public bool Ocupado { get; set; }

    [Parameter]
    public EventCallback<long> VerDetalle { get; set; }

    [Parameter]
    public EventCallback<long> Editar { get; set; }

    [Parameter]
    public EventCallback<GastoSalidaDTO> Desactivar { get; set; }
}
